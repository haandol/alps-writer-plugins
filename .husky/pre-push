# pre-push — the fast checks before a push: the unit tests and every static check
# CI runs, so a push is not red on GitHub for a reason already sitting in the tree.
#
# Integration tests — the ones that need git, a browser or another external tool —
# take minutes here and are left to CI, whose required jobs run them on every pull
# request; `pnpm test:integration` runs them locally. Everything this hook does also
# runs in CI, so a failure here is one CI would report too.
#
# Formatting still belongs to pre-commit as well (lint-staged fixes it in place);
# checking it again here is what catches a commit made with --no-verify.
#
# Mirrors .github/workflows/ci.yaml:
#   test/runtime → pnpm test (workspace suites + dependency-free ADR suite); this
#                  hook runs its generated-asset checks and unit tests
#   build job    → pnpm lint, pnpm format:check, pnpm bump:check, pnpm build +
#                  the committed-bundle drift check
#   runtime job  → the bundle answers MCP initialize, and the hook starts, both
#                  under a bare `node` with no node_modules in play
#
# Bypass: SKIP_TESTS=1 git push … skips only the unit tests, for a WIP branch you
# know is red. It is rejected for pushes that update main. Everything else always
# runs — those checks are seconds each and each one catches a distinct way the
# pushed tree can be broken.

set -u

# Hooks export repository selectors, including an absolute GIT_DIR in linked
# worktrees. Test fixtures must discover their own repositories from their cwd
# instead of writing commits, config or index entries into the pushed checkout.
for hook_git_var in $(git rev-parse --local-env-vars); do
  unset "$hook_git_var"
done

PUSH_UPDATES="$(cat)"

fail() {
  echo ""
  echo "[pre-push] ✗ $1"
  [ $# -gt 1 ] && echo "    $2"
  echo "    (CI would fail on this too — fix it, or see .husky/pre-push for the bypass.)"
  exit 1
}

# ── checks that only read the tree, started alongside the tests ─────────────
# They take seconds each and touch nothing the tests read or write, so they run
# while they run. Each one's output is kept and shown after the suite, in this
# order, and the first failure is reported exactly as when they ran in turn.
# The rebuild below rewrites generated files the tests check, so it waits.
CHECKS="$(mktemp -d "${TMPDIR:-/tmp}/pre-push.XXXXXX")"
trap 'rm -rf "$CHECKS"' EXIT

# lint + formatting (CI build job)
check_lint() { pnpm lint; }
check_format() { pnpm format:check; }

# Release version across all 13 sites. Only 8 are covered by a test; the five
# rules-version stamps in templates/adr/ are checked nowhere else, and a stamp
# left behind makes the plugin report its own templates as stale to every
# consumer at once.
check_bump() { pnpm bump:check; }

# What a consumer runs, with no node_modules (CI runtime job). A marketplace
# install ships no dependencies: the MCP server is a bundle with them inlined,
# and the adr-writer hook is Node built-ins only. Both are executed by `node`
# directly, so `pnpm test` passing says nothing about them starting.
#
# This runs BEFORE the rebuild below, on purpose: it must judge the bundle being
# pushed, not one `pnpm build` just regenerated. Checking after the rebuild made
# this vacuous — a hand-edited or truncated dist/ passed, because the file under
# test was no longer the file in the commit.
INIT='{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2024-11-05","capabilities":{},"clientInfo":{"name":"pre-push","version":"0"}}}'
check_bundle() {
  printf '%s\n' "$INIT" | node plugins/alps-writer/dist/index.js 2>/dev/null | head -1 |
    grep -q '"name":"alps-writer"'
}
check_hook() {
  echo '{"hook_event_name":"SessionStart","source":"startup"}' |
    node plugins/adr-writer/hooks/surface-adr-context.mjs >/dev/null
}

for check in lint format bump bundle hook; do
  (
    if "check_$check" >"$CHECKS/$check.log" 2>&1; then status=0; else status=1; fi
    echo "$status" >"$CHECKS/$check.status"
  ) &
done

# ── the unit tests ─────────────────────────────────────────────────────────
suite=0
if [ "${SKIP_TESTS:-}" = "1" ]; then
  if printf '%s\n' "$PUSH_UPDATES" | awk '$3 == "refs/heads/main" { found = 1 } END { exit !found }'; then
    wait
    fail "SKIP_TESTS=1 is not allowed when updating main." "Push the WIP branch, then merge through a protected pull request."
  fi
  echo "[pre-push] ⚠ SKIP_TESTS=1 — skipping the unit tests."
else
  { pnpm test:checks && pnpm test:unit; } || suite=1
fi
wait
[ "$suite" = 0 ] ||
  fail "tests failed." "Push a known-red WIP branch with: SKIP_TESTS=1 git push …"

# Report the checks that ran alongside, in order.
passed() {
  cat "$CHECKS/$1.log"
  [ "$(cat "$CHECKS/$1.status" 2>/dev/null)" = 0 ]
}
passed lint ||
  fail "ESLint reported problems." "Auto-fix what it can: pnpm --filter alps-writer lint:fix"
passed format ||
  fail "files are not Prettier-formatted." "Fix with: pnpm format"
passed bump ||
  fail "the release version drifted between sites." "Fix with: pnpm bump <version>"
passed bundle ||
  fail "the committed MCP bundle did not answer initialize." "Try it by hand: node plugins/alps-writer/dist/index.js"
passed hook ||
  fail "the adr-writer SessionStart hook failed to run." "It seeds ADR context when a session starts or is restored, so this breaks the plugin immediately."

# ── the committed bundle matches src (CI build job) ────────────────────────
# plugins/alps-writer/dist/ is committed and a marketplace install runs it
# directly, so a stale bundle ships old code. pre-commit rebuilds it when src is
# staged, but --no-verify defeats that; this is the backstop.
# The build includes tsc --noEmit; do not typecheck the same tree twice.
pnpm build ||
  fail "build failed."

if ! git diff --quiet -- plugins/alps-writer/dist; then
  git diff --stat -- plugins/alps-writer/dist
  fail "the committed bundle is stale." "Stage the rebuild: git add plugins/alps-writer/dist"
fi

echo "[pre-push] ✓ unit tests and static checks passed (CI runs the integration tests)"
