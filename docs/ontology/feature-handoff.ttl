@prefix m: <urn:ontology-writer:model:> .
@prefix onto: <urn:ontology-writer:vocabulary:> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

m:handoff-coordinator a onto:Actor ;
    rdfs:label "기능 인계 담당자" ;
    onto:definition "기획에 담긴 계약과 미정 사항을 기능별로 정리하고 확정된 계약을 결정 기록으로 넘기는 역할." ;
    onto:performs m:feature-handoff.assess-contract, m:feature-handoff.transfer-contract .

m:model-change-approver a onto:Actor ;
    rdfs:label "업무 모델 변경 승인자" ;
    onto:definition "업무 용어의 뜻과 기능 사이의 관계에 관한 변경 제안을 검토하고 채택 여부를 결정하는 사용자." ;
    onto:performs m:business-change.decide-model-change, m:feature-handoff.decide-model-change .

m:feature-handoff.contract-assessed a onto:BusinessEvent ;
    rdfs:label "기능별 인계 내용 검토됨" ;
    onto:definition "해당 기능에서 이전할 계약과 업무 모델에 제안할 변경의 유무가 드러났다." ;
    onto:triggers m:feature-handoff.review-proposal, m:feature-handoff.transfer-when-ready ;
    onto:inContext m:product-planning .

m:feature-handoff.contract-transferred a onto:BusinessEvent ;
    rdfs:label "기능 계약 인계됨" ;
    onto:definition "해당 기능의 구현 계약이 결정 기록에 갖추어져 기획 문서를 구현 기준으로 사용하는 일이 끝났다." ;
    onto:inContext m:architecture-decision .

m:feature-handoff.meaning-adopted a onto:BusinessEvent ;
    rdfs:label "제안한 업무 의미 확정됨" ;
    onto:definition "사용자가 승인한 뜻이나 관계를 업무 모델에 반영해 관련 기능의 인계에 사용할 수 있게 되었다." ;
    onto:triggers m:feature-handoff.transfer-when-ready ;
    onto:inContext m:business-modeling .

m:feature-handoff.proposal-declined a onto:BusinessEvent ;
    rdfs:label "업무 의미 변경 제안 거절됨" ;
    onto:definition "사용자가 제안을 거절해 기존 업무 모델의 뜻을 유지하기로 했다." ;
    onto:inContext m:business-modeling .

m:feature-handoff a onto:Process ;
    rdfs:label "기획한 기능의 계약 인계" ;
    onto:definition "기획에서 정한 기능의 의도와 구현 계약을 정리하고, 새 업무 의미가 필요한 기능은 그 뜻을 확인한 뒤 구현의 기준을 결정 기록으로 넘긴다." ;
    onto:startCondition "사용자가 기획한 기능의 계약을 결정 기록으로 옮기도록 요청했다." ;
    onto:businessOutcome "인계가 끝난 기능은 결정 기록만으로 구현할 수 있고, 뜻이 확정되지 않은 기능은 기획 문서에 남아 인계를 기다린다." ;
    onto:openScope "인계가 끝난 기능의 기획이 바뀐 뒤 사용자가 다시 인계를 요청하는 경우."^^onto:OpenPath ;
    onto:status "Accepted (2026-11-18)" ;
    onto:hasStep m:feature-handoff.assess-contract, m:feature-handoff.decide-model-change, m:feature-handoff.transfer-contract .

m:feature-handoff.assess-contract a onto:Step ;
    rdfs:label "기능별 인계 내용 검토" ;
    onto:definition "기능의 목적과 구현 계약을 확인한다. 업무 모델이 소유하는 뜻은 기존 정의를 재사용하고, 새 정의나 의미 변경 또는 새 기능 관계는 영향을 받는 기능과 함께 변경 제안으로 정리한다." ;
    onto:stepKind "system" ;
    onto:emits m:feature-handoff.contract-assessed ;
    onto:inContext m:product-planning .

m:feature-handoff.decide-model-change a onto:Step ;
    rdfs:label "업무 모델 변경 제안 결정" ;
    onto:definition "사용자가 인계 중 제안된 업무 의미의 변경을 승인하거나 거절한다. 승인한 내용만 업무 모델에 반영한다." ;
    onto:stepKind "system" ;
    onto:emits m:feature-handoff.meaning-adopted, m:feature-handoff.proposal-declined ;
    onto:inContext m:business-modeling .

m:feature-handoff.transfer-contract a onto:Step ;
    rdfs:label "기능 계약 인계 완료" ;
    onto:definition "인계 담당자가 사용자가 승인한 기능 계약 전체를 소유하는 결정 기록을 확인하고, 해당 기능의 구현 기준을 기획 문서에서 결정 기록으로 넘긴다." ;
    onto:stepKind "system" ;
    onto:emits m:feature-handoff.contract-transferred ;
    onto:inContext m:architecture-decision .

m:feature-handoff.review-proposal a onto:Policy ;
    rdfs:label "새 업무 의미의 확인" ;
    onto:definition "업무 모델의 의미가 달라지는 제안을 영향받는 기능과 함께 사용자의 판단에 맡긴다." ;
    onto:reactionCondition "인계할 내용에 업무 모델이 소유할 새 정의, 기존 정의의 의미 변경 또는 새로운 기능 사이 관계가 있다." ;
    onto:basisKind "contract" ;
    onto:basis "기능 인계에서 발견한 새 업무 의미는 사용자가 승인한 범위에서만 업무 모델에 반영한다." ;
    onto:starts m:feature-handoff.decide-model-change ;
    onto:inContext m:business-modeling .

m:feature-handoff.transfer-when-ready a onto:Policy ;
    rdfs:label "준비된 기능의 인계" ;
    onto:definition "각 기능이 의존하는 업무 의미와 계약의 준비 여부에 따라 그 기능의 인계를 마친다." ;
    onto:reactionCondition "해당 기능이 의존하는 업무 뜻과 관계가 확정되고, 필요한 선행 기능의 인계와 해당 기능의 전체 구현 계약에 대한 승인·기록 등 나머지 인계 조건도 충족됐다." ;
    onto:basisKind "contract" ;
    onto:basis "기능의 구현 기준은 그 기능에 필요한 계약 전체가 이전된 시점에 결정 기록으로 넘어간다." ;
    onto:starts m:feature-handoff.transfer-contract ;
    onto:inContext m:architecture-decision .

m:feature-handoff.hold-dependent-feature a onto:BusinessRule ;
    rdfs:label "미확정 제안에 의존하는 기능의 인계 보류" ;
    onto:definition "승인 대기이거나 거절된 업무 의미에 의존하는 기능은 인계를 보류한다. 그 의미와 독립인 기능은 자신의 다른 인계 조건을 충족하면 인계를 마칠 수 있다." ;
    onto:basisKind "contract" ;
    onto:basis "업무 의미를 확정하는 책임과 기획에서 결정 기록으로 구현 기준을 넘기는 책임은 기능별로 연결된다." ;
    onto:constrains m:feature-handoff.assess-contract, m:feature-handoff.decide-model-change, m:feature-handoff.transfer-contract .

m:feature-handoff.approved-meaning a onto:ObservationCriterion ;
    rdfs:label "승인된 업무 의미로 인계 완료" ;
    onto:startCondition "새 업무 의미의 변경 제안을 사용자가 승인하고 해당 기능의 나머지 인계 조건도 충족됐다." ;
    onto:observedResult "승인한 뜻이 업무 모델에 반영되고, 그 뜻에 의존하던 기능은 인계를 마쳐 결정 기록으로 구현할 수 있다." ;
    onto:criterionOf m:feature-handoff ;
    onto:passesThrough m:feature-handoff.contract-transferred, m:feature-handoff.meaning-adopted .

m:feature-handoff.declined-meaning a onto:ObservationCriterion ;
    rdfs:label "제안 거절 후 독립 기능 인계" ;
    onto:startCondition "사용자가 업무 의미 변경을 거절했다. 함께 인계를 요청한 기능 중 하나만 그 제안에 의존하고, 독립 기능은 다른 인계 조건을 충족했다." ;
    onto:observedResult "거절된 뜻은 업무 모델에 반영되지 않는다. 그 뜻에 의존하는 기능은 보류하며, 독립 기능은 인계를 마칠 수 있다." ;
    onto:criterionOf m:feature-handoff ;
    onto:passesThrough m:feature-handoff.contract-transferred, m:feature-handoff.proposal-declined .

m:feature-handoff.existing-meaning a onto:ObservationCriterion ;
    rdfs:label "기존 업무 의미로 인계 완료" ;
    onto:startCondition "기능에서 사용하는 뜻과 관계가 업무 모델에 같은 의미로 존재하고 해당 기능의 다른 인계 조건이 충족됐다." ;
    onto:observedResult "새 모델 변경 제안 없이 해당 기능의 결정 기록이 구현 기준이 된다." ;
    onto:criterionOf m:feature-handoff ;
    onto:passesThrough m:feature-handoff.contract-assessed, m:feature-handoff.contract-transferred .

m:feature-handoff.pending-meaning a onto:ObservationCriterion ;
    rdfs:label "승인 대기 중 독립 기능 인계" ;
    onto:startCondition "함께 인계를 요청한 기능 중 일부만 승인 대기 중인 제안에 의존하고, 독립 기능은 다른 인계 조건을 충족했다." ;
    onto:observedResult "승인 대기인 뜻에 의존하는 기능은 기획 문서를 기준으로 남고, 독립 기능은 인계를 마칠 수 있다." ;
    onto:criterionOf m:feature-handoff ;
    onto:passesThrough m:feature-handoff.contract-assessed, m:feature-handoff.contract-transferred .
