@prefix m: <urn:ontology-writer:model:> .
@prefix onto: <urn:ontology-writer:vocabulary:> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

m:customer a onto:Actor ;
    rdfs:label "고객" ;
    onto:definition "상품을 주문하고 해당 주문의 결제를 요청하는 사람의 역할." ;
    onto:performs m:ordering.submit-order, m:payment.request-payment .

m:order-system a onto:Actor ;
    rdfs:label "주문 처리 시스템" ;
    onto:definition "결제 결과를 확인해 주문을 확정하는 시스템 역할." ;
    onto:performs m:ordering.confirm-order .

m:payment-provider a onto:Actor ;
    rdfs:label "외부 결제 제공자" ;
    onto:definition "상점 밖에서 결제를 승인하고 대금을 수납하는 조직." ;
    onto:performs m:payment.capture-payment .

m:ordering a onto:BoundedContext ;
    rdfs:label "주문 관리" ;
    onto:definition "고객의 구매 요청을 접수하고 주문을 확정하는 책임 범위." .

m:payment a onto:BoundedContext ;
    rdfs:label "결제 처리" ;
    onto:definition "주문의 결제를 요청하고 수납 결과를 다루는 책임 범위." .

m:ordering.order a onto:BusinessConcept ;
    rdfs:label "주문" ;
    onto:definition "고객의 상품 구매 요청을 나타내는 업무 정보." ;
    onto:inContext m:ordering .

m:payment.payment a onto:BusinessConcept ;
    rdfs:label "결제 내역" ;
    onto:definition "주문 대금의 결제 요청과 수납 결과를 나타내는 업무 정보." ;
    onto:refersTo m:ordering.order ;
    onto:inContext m:payment .

m:ordering.order-confirmed a onto:BusinessEvent ;
    rdfs:label "주문 확정됨" ;
    onto:definition "상점이 해당 주문을 이행하기로 확정했다." ;
    onto:inContext m:ordering .

m:ordering.order-placed a onto:BusinessEvent ;
    rdfs:label "주문 접수됨" ;
    onto:definition "고객의 구매 요청이 주문으로 접수되었다." ;
    onto:triggers m:payment.request-on-order ;
    onto:inContext m:ordering .

m:payment.payment-completed a onto:BusinessEvent ;
    rdfs:label "결제 완료됨" ;
    onto:definition "해당 주문의 대금 결제가 완료되었다." ;
    onto:triggers m:ordering.confirm-on-payment ;
    onto:inContext m:payment .

m:ordering.place-order a onto:Process ;
    rdfs:label "주문 접수부터 확정까지" ;
    onto:definition "고객의 주문을 접수하고 결제 결과를 받아 주문을 확정하는 업무." ;
    onto:startCondition "고객이 구매할 상품을 주문으로 제출한다." ;
    onto:businessOutcome "주문이 확정되고 고객이 그 결과를 확인한다." ;
    onto:openScope "결제가 실패한 주문의 처리 경로."^^onto:OpenPath ;
    onto:status "Proposed" ;
    onto:hasStep m:ordering.confirm-order, m:ordering.submit-order .

m:payment.take-payment a onto:Process ;
    rdfs:label "주문 대금 결제" ;
    onto:definition "접수된 주문의 결제를 요청하고 외부 결제 제공자의 수납 결과를 받는 업무." ;
    onto:startCondition "주문이 접수되었다." ;
    onto:businessOutcome "해당 주문의 대금 결제가 완료된다." ;
    onto:openScope "결제 거절 뒤 재시도를 시작하는 주체와 방식."^^onto:OpenPath ;
    onto:status "Proposed" ;
    onto:hasStep m:payment.capture-payment, m:payment.request-payment .

m:ordering.confirm-order a onto:Step ;
    rdfs:label "주문 확정" ;
    onto:definition "주문 처리 시스템이 결제된 주문을 이행하기 위해 확정한다." ;
    onto:stepKind "system" ;
    onto:openScope "이미 처리한 결제 완료 사건을 다시 받았을 때의 응답."^^onto:OpenPath ;
    onto:emits m:ordering.order-confirmed ;
    onto:uses m:ordering.order ;
    onto:inContext m:ordering .

m:ordering.submit-order a onto:Step ;
    rdfs:label "주문 접수" ;
    onto:definition "고객이 구매 요청을 주문으로 제출한다." ;
    onto:stepKind "system" ;
    onto:flowsTo m:ordering.confirm-order ;
    onto:emits m:ordering.order-placed ;
    onto:uses m:ordering.order ;
    onto:inContext m:ordering .

m:payment.capture-payment a onto:Step ;
    rdfs:label "대금 결제" ;
    onto:definition "외부 결제 제공자가 결제를 승인하고 주문 대금을 수납한다." ;
    onto:stepKind "outside-system" ;
    onto:emits m:payment.payment-completed ;
    onto:uses m:payment.payment ;
    onto:inContext m:payment .

m:payment.request-payment a onto:Step ;
    rdfs:label "결제 요청" ;
    onto:definition "고객이 해당 주문의 결제를 요청한다." ;
    onto:stepKind "system" ;
    onto:flowsTo m:payment.capture-payment ;
    onto:uses m:payment.payment ;
    onto:inContext m:payment .

m:ordering.confirm-on-payment a onto:Policy ;
    rdfs:label "결제 완료 후 주문 확정" ;
    onto:definition "주문 대금의 결제 완료에 반응해 주문을 확정한다." ;
    onto:reactionCondition "완료된 결제가 확정하려는 주문의 결제이다." ;
    onto:basisKind "operating-policy" ;
    onto:basis "상점 운영 정책: 대금 결제가 끝나기 전에 주문을 확정하지 않는다." ;
    onto:starts m:ordering.confirm-order ;
    onto:uses m:ordering.order ;
    onto:inContext m:ordering .

m:payment.request-on-order a onto:Policy ;
    rdfs:label "주문 접수 후 결제 요청" ;
    onto:definition "주문 접수에 반응해 고객의 결제를 요청한다." ;
    onto:reactionCondition "해당 주문에 아직 결제가 없다." ;
    onto:basisKind "user-decision" ;
    onto:basis "상점의 결정: 주문 접수 뒤 결제를 요청한다." ;
    onto:starts m:payment.request-payment ;
    onto:inContext m:payment .

m:payment.amount-matches-order a onto:BusinessRule ;
    rdfs:label "주문 금액과 수납 금액의 일치" ;
    onto:definition "수납한 금액은 해당 주문의 금액과 같아야 한다." ;
    onto:basisKind "operating-policy" ;
    onto:basis "상점 회계 규칙." ;
    onto:constrains m:ordering.order, m:payment.payment .

m:ordering.place-order.confirmed a onto:ObservationCriterion ;
    rdfs:label "결제한 주문의 확정 결과 확인" ;
    onto:startCondition "고객이 주문을 접수하고 해당 주문의 결제를 완료한다." ;
    onto:observedResult "고객이 해당 주문의 확정 결과를 확인한다." ;
    onto:criterionOf m:ordering.place-order ;
    onto:passesThrough m:ordering.order-confirmed, m:ordering.order-placed, m:payment.payment-completed .

m:payment.take-payment.completed a onto:ObservationCriterion ;
    rdfs:label "주문 대금의 결제 완료 확인" ;
    onto:startCondition "주문이 접수되어 고객이 결제를 요청한다." ;
    onto:observedResult "해당 주문의 대금 결제 완료를 확인한다." ;
    onto:criterionOf m:payment.take-payment ;
    onto:passesThrough m:ordering.order-placed, m:payment.payment-completed .
