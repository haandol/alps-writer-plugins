@prefix pm: <urn:adr-writer:process:> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# ADR Writer business process vocabulary.
#
# The closed set of element types, relations and attributes a business process
# model in docs/process/ may use. RDFS domain and range are inference rules, not
# constraints, so a relation declares them only when both of its ends accept a
# single element type, and an attribute declares its domain only when it applies
# to a single element type. ADR Writer validates type combinations and counts
# itself, under a closed world. Model documents never copy this file.

pm: rdfs:label "ADR Writer business process vocabulary"@en, "ADR Writer 업무 프로세스 어휘"@ko ;
    rdfs:comment "Closed vocabulary of the business process model level above ADRs."@en .

# Element types

pm:Actor a rdfs:Class ;
    rdfs:label "Actor"@en, "행위자"@ko ;
    rdfs:comment "A person's role, an operator, an outside organization or system, or a system role that performs automatic work."@en .

pm:BoundedContext a rdfs:Class ;
    rdfs:label "Bounded context"@en, "바운디드 컨텍스트"@ko ;
    rdfs:comment "A business boundary inside which terms and rules keep one consistent meaning."@en .

pm:BusinessConcept a rdfs:Class ;
    rdfs:label "Business concept"@en, "업무 개념"@ko ;
    rdfs:comment "A business noun defined inside one context."@en .

pm:BusinessEvent a rdfs:Class ;
    rdfs:label "Business event"@en, "업무 사건"@ko ;
    rdfs:comment "A fact that already happened in the business, independent of how it is delivered technically."@en .

pm:Process a rdfs:Class ;
    rdfs:label "Process"@en, "프로세스"@ko ;
    rdfs:comment "A flow from a start condition to a business outcome."@en .

pm:Step a rdfs:Class ;
    rdfs:label "Step"@en, "단계"@ko ;
    rdfs:comment "A business activity an actor performs inside a process."@en .

pm:Policy a rdfs:Class ;
    rdfs:label "Policy"@en, "정책"@ko ;
    rdfs:comment "A decision rule that reacts to a business event and starts a step when its condition holds."@en .

pm:BusinessRule a rdfs:Class ;
    rdfs:label "Business rule"@en, "업무 규칙"@ko ;
    rdfs:comment "A condition that must always hold across two or more steps."@en .

pm:ObservationCriterion a rdfs:Class ;
    rdfs:label "Observation criterion"@en, "관찰 기준"@ko ;
    rdfs:comment "A start condition of a process and the business result to observe."@en .

# Relations

pm:hasStep a rdf:Property ;
    rdfs:label "contains"@en, "포함"@ko ;
    rdfs:comment "A process contains a step."@en ;
    rdfs:domain pm:Process ;
    rdfs:range pm:Step .

pm:flowsTo a rdf:Property ;
    rdfs:label "flow"@en, "흐름"@ko ;
    rdfs:comment "Order of progress between steps of the same process. Order only, never a cause; when several flows leave a step, all of them proceed."@en ;
    rdfs:domain pm:Step ;
    rdfs:range pm:Step .

pm:performs a rdf:Property ;
    rdfs:label "performs"@en, "수행"@ko ;
    rdfs:comment "An actor performs a step. Several performers are alternatives: any of them may perform it."@en ;
    rdfs:domain pm:Actor ;
    rdfs:range pm:Step .

pm:emits a rdf:Property ;
    rdfs:label "emits"@en, "발생"@ko ;
    rdfs:comment "An event happens as a result of a step."@en ;
    rdfs:domain pm:Step ;
    rdfs:range pm:BusinessEvent .

pm:triggers a rdf:Property ;
    rdfs:label "triggers"@en, "촉발"@ko ;
    rdfs:comment "An event wakes a policy. A policy with several triggering events reacts each time one of them happens."@en ;
    rdfs:domain pm:BusinessEvent ;
    rdfs:range pm:Policy .

pm:starts a rdf:Property ;
    rdfs:label "starts"@en, "시작"@ko ;
    rdfs:comment "A policy starts a step when its condition holds."@en ;
    rdfs:domain pm:Policy ;
    rdfs:range pm:Step .

pm:uses a rdf:Property ;
    rdfs:label "uses"@en, "사용"@ko ;
    rdfs:comment "A step or a policy reads, changes or decides with a concept. Accepted sources: Step, Policy."@en .

pm:constrains a rdf:Property ;
    rdfs:label "constrains"@en, "제약"@ko ;
    rdfs:comment "A business rule applies to its target. Accepted targets: Step, Policy, BusinessConcept, Process."@en .

pm:hasPart a rdf:Property ;
    rdfs:label "composition"@en, "구성"@ko ;
    rdfs:comment "One concept has another concept as a part."@en ;
    rdfs:domain pm:BusinessConcept ;
    rdfs:range pm:BusinessConcept .

pm:refersTo a rdf:Property ;
    rdfs:label "reference"@en, "참조"@ko ;
    rdfs:comment "One concept points at another concept."@en ;
    rdfs:domain pm:BusinessConcept ;
    rdfs:range pm:BusinessConcept .

pm:correspondsTo a rdf:Property ;
    rdfs:label "correspondence"@en, "대응"@ko ;
    rdfs:comment "A concept that points at the same thing as a concept of another context."@en ;
    rdfs:domain pm:BusinessConcept ;
    rdfs:range pm:BusinessConcept .

pm:inContext a rdf:Property ;
    rdfs:label "context membership"@en, "컨텍스트 소속"@ko ;
    rdfs:comment "The business boundary an element belongs to. Accepted sources: Step, Policy, BusinessConcept, BusinessEvent."@en .

pm:criterionOf a rdf:Property ;
    rdfs:label "criterion membership"@en, "기준 소속"@ko ;
    rdfs:comment "The process an observation criterion checks."@en ;
    rdfs:domain pm:ObservationCriterion ;
    rdfs:range pm:Process .

pm:passesThrough a rdf:Property ;
    rdfs:label "passes through"@en, "경유"@ko ;
    rdfs:comment "An event the criterion passes through between its start condition and its result."@en ;
    rdfs:domain pm:ObservationCriterion ;
    rdfs:range pm:BusinessEvent .

# Fact attributes (the element name is rdfs:label)

pm:definition a rdf:Property ;
    rdfs:label "definition"@en, "정의"@ko ;
    rdfs:comment "Fact attribute. What the element means in business language. Required on every element except observation criteria."@en ;
    rdfs:range rdfs:Literal .

pm:stepKind a rdf:Property ;
    rdfs:label "step kind"@en, "단계 구분"@ko ;
    rdfs:comment "Fact attribute. \"system\" for a step done in the system, \"outside-system\" for a step done outside it."@en ;
    rdfs:domain pm:Step ;
    rdfs:range rdfs:Literal .

pm:reactionCondition a rdf:Property ;
    rdfs:label "reaction condition"@en, "반응 조건"@ko ;
    rdfs:comment "Fact attribute. The relation and meaning a policy checks before starting its step, without exact values."@en ;
    rdfs:domain pm:Policy ;
    rdfs:range rdfs:Literal .

pm:basisKind a rdf:Property ;
    rdfs:label "basis kind"@en, "근거 종류"@ko ;
    rdfs:comment "Fact attribute of policies and business rules: \"regulation\", \"contract\", \"operating-policy\" or \"user-decision\"."@en ;
    rdfs:range rdfs:Literal .

pm:basis a rdf:Property ;
    rdfs:label "basis"@en, "근거"@ko ;
    rdfs:comment "Fact attribute of policies and business rules: the regulation, contract, policy or decision behind it."@en ;
    rdfs:range rdfs:Literal .

pm:startCondition a rdf:Property ;
    rdfs:label "start condition"@en, "시작 조건"@ko ;
    rdfs:comment "Fact attribute of processes and observation criteria."@en ;
    rdfs:range rdfs:Literal .

pm:businessOutcome a rdf:Property ;
    rdfs:label "business outcome"@en, "업무 결과"@ko ;
    rdfs:comment "Fact attribute. The business result a process reaches."@en ;
    rdfs:domain pm:Process ;
    rdfs:range rdfs:Literal .

pm:observedResult a rdf:Property ;
    rdfs:label "observed result"@en, "관찰 결과"@ko ;
    rdfs:comment "Fact attribute. The business result an observation criterion checks."@en ;
    rdfs:domain pm:ObservationCriterion ;
    rdfs:range rdfs:Literal .

pm:openScope a rdf:Property ;
    rdfs:label "open scope"@en, "미정 범위"@ko ;
    rdfs:comment "Fact attribute of processes (required) and steps. Each value is typed pm:OpenPath, pm:NotApplicable or pm:NoOpenScope."@en ;
    rdfs:range rdfs:Literal .

pm:OpenPath a rdfs:Datatype ;
    rdfs:label "open path"@en, "미정 경로"@ko ;
    rdfs:comment "A path the model does not cover yet, in business language."@en .

pm:NotApplicable a rdfs:Datatype ;
    rdfs:label "not applicable"@en, "해당 없음"@ko ;
    rdfs:comment "A path, or one of the three coverage axes, the user confirmed the business does not have. Recorded on processes only."@en .

pm:NoOpenScope a rdfs:Datatype ;
    rdfs:label "no open scope"@en, "미정 범위 없음"@ko ;
    rdfs:comment "States that a process has neither open paths nor not-applicable items. Used alone."@en .

# Description attributes (the note is rdfs:comment)

pm:summary a rdf:Property ;
    rdfs:label "one-line summary"@en, "한 줄 요약"@ko ;
    rdfs:comment "Description attribute of processes. Never used to decide anything."@en ;
    rdfs:domain pm:Process ;
    rdfs:range rdfs:Literal .

# Lifecycle attributes

pm:status a rdf:Property ;
    rdfs:label "Status"@en, "Status"@ko ;
    rdfs:comment "Lifecycle attribute of processes. Changed only by ADR Writer lifecycle transitions."@en ;
    rdfs:domain pm:Process ;
    rdfs:range rdfs:Literal .

pm:replacedBy a rdf:Property ;
    rdfs:label "replaced by"@en, "대체 대상"@ko ;
    rdfs:comment "Lifecycle attribute of processes: the process that replaces this one."@en ;
    rdfs:domain pm:Process ;
    rdfs:range pm:Process .
